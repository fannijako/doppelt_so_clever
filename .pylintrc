[MESSAGES CONTROL]
disable=missing-module-docstring,missing-function-docstring,missing-class-docstring,logging-fstring-interpolation

[FORMAT]
max-line-length=127

[DESIGN]
max-attributes=9
max-args=9
max-positional-arguments=9
max-locals=18
min-public-methods=1

[MASTER]
ignored-modules=setuptools
extension-pkg-allow-list=arcade
