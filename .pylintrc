[MESSAGES CONTROL]
disable=missing-module-docstring,missing-function-docstring,missing-class-docstring,logging-fstring-interpolation

[FORMAT]
max-line-length=127

[MASTER]
ignored-modules=setuptools,pygame

[DESIGN]
max-args=9
max-attributes=17
max-branches=16
max-locals=23
max-public-methods=8
min-public-methods=1
max-statements=53
